# 데이터베이스
DATABASE_URL=postgresql://user:password@localhost:5432/luxfind_saas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/luxfind_saas

# Redis
REDIS_URL=redis://localhost:6379

# 세션
SESSION_SECRET=your-super-secret-session-key-change-this

# JWT
JWT_SECRET=your-jwt-secret-key-change-this

# AI 서버 (Vultr GPU)
AI_SERVER_URL=http://your-vultr-gpu-ip:8000

# 외부 API
GROQ_API_KEY=your-groq-api-key
FLUX_API_KEY=your-flux-api-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
CLOUDFLARE_R2_ACCOUNT_ID=your-r2-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=luxfind-images

# 결제 (토스페이먼츠)
TOSS_CLIENT_KEY=your-toss-client-key
TOSS_SECRET_KEY=your-toss-secret-key

# 이메일
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# 환경
NODE_ENV=development
PORT=3000
