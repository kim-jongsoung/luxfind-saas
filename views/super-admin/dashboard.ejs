<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>슈퍼 관리자 대시보드 - 럭스파인드</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
  <style>
    * { font-family: 'Noto Sans KR', sans-serif; }
    .stat-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border-radius: 15px;
      padding: 25px;
      margin-bottom: 20px;
    }
    .stat-value {
      font-size: 2.5rem;
      font-weight: 700;
    }
    .stat-label {
      font-size: 0.9rem;
      opacity: 0.9;
    }
  </style>
</head>
<body>
  <%- include('../partials/super-admin-navbar', { admin }) %>
  
  <div class="container mt-4">
    <h1 class="mb-4">📊 전체 현황</h1>
    
    <div class="row">
      <div class="col-md-3">
        <div class="stat-card">
          <div class="stat-label">총 여행사</div>
          <div class="stat-value"><%= stats.total_agencies || 0 %>개</div>
        </div>
      </div>
      
      <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #4FC3F7 0%, #667eea 100%);">
          <div class="stat-label">활성 여행사</div>
          <div class="stat-value"><%= stats.active_agencies || 0 %>개</div>
        </div>
      </div>
      
      <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
          <div class="stat-label">월 매출</div>
          <div class="stat-value">₩<%= (stats.monthly_revenue || 0).toLocaleString() %></div>
        </div>
      </div>
      
      <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
          <div class="stat-label">AI 상담</div>
          <div class="stat-value"><%= (stats.total_chats || 0).toLocaleString() %>건</div>
        </div>
      </div>
    </div>
    
    <div class="card mt-4">
      <div class="card-header">
        <h5 class="mb-0">최근 등록 여행사</h5>
      </div>
      <div class="card-body">
        <table class="table">
          <thead>
            <tr>
              <th>회사명</th>
              <th>구독 플랜</th>
              <th>상태</th>
              <th>등록일</th>
            </tr>
          </thead>
          <tbody>
            <% recentAgencies.forEach(agency => { %>
              <tr>
                <td><%= agency.company_name %></td>
                <td>
                  <% if (agency.subscription_plan === 'starter') { %>
                    <span class="badge bg-secondary">스타터</span>
                  <% } else if (agency.subscription_plan === 'pro') { %>
                    <span class="badge bg-primary">프로</span>
                  <% } else { %>
                    <span class="badge bg-success">엔터프라이즈</span>
                  <% } %>
                </td>
                <td>
                  <% if (agency.subscription_status === 'active') { %>
                    <span class="badge bg-success">활성</span>
                  <% } else { %>
                    <span class="badge bg-danger">중지</span>
                  <% } %>
                </td>
                <td><%= new Date(agency.created_at).toLocaleDateString('ko-KR') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
